{
	"ID": "20211226123130-jpeg5b2",
	"Spec": "2",
	"Type": "NodeDocument",
	"Properties": {
		"id": "20211226123130-jpeg5b2",
		"title": "書籤、標籤和備註",
		"type": "doc",
		"updated": "20261117103000"
	},
	"Children": [
		{
			"ID": "20211226123145-atmx4pn",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20211226123145-atmx4pn",
				"updated": "20261024161440"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "書簽"
				}
			]
		},
		{
			"ID": "20211226123145-786ipku",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20211226123145-786ipku",
				"updated": "20260730184353"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "如果你需要“收藏”內容區塊，請通過區塊標菜單打開屬性面板，然後就可以在屬性面板中設置書簽了。"
				}
			]
		},
		{
			"ID": "20211226123145-3rhy0b6",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20211226123145-3rhy0b6",
				"updated": "20261024161440"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "收藏的內容區塊會列在書籤面板中（"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "Alt"
				},
				{
					"Type": "NodeText",
					"Data": "+"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "3"
				},
				{
					"Type": "NodeText",
					"Data": "，macOS 為 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "Control"
				},
				{
					"Type": "NodeText",
					"Data": "+"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "3"
				},
				{
					"Type": "NodeText",
					"Data": "）。取消收藏時，清空區塊的書籤屬性，或使用書籤面板中的刪除操作；這只移除書籤，不會刪除內容區塊。"
				}
			]
		},
		{
			"ID": "20211226123145-fgyfo0x",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20211226123145-fgyfo0x",
				"updated": "20260810212846"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "標簽"
				}
			]
		},
		{
			"ID": "20211226123145-nxlldt1",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20211226123145-nxlldt1",
				"updated": "20260730184353"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "標簽用於在內容區塊中對該區塊進行標記。語法是通過一前一後兩個 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "#"
				},
				{
					"Type": "NodeText",
					"Data": " 將標簽標識包裹起來，像這樣 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "#標簽#"
				},
				{
					"Type": "NodeText",
					"Data": "。"
				}
			]
		},
		{
			"ID": "20211226123145-fvftrvl",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20211226123145-fvftrvl",
				"updated": "20260730184353"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "標簽支援層級，這樣可以更方便地對內容區塊進行分類整理。不同層級之間使用 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "/"
				},
				{
					"Type": "NodeText",
					"Data": " 分隔，像這樣 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "#A/B/C#"
				},
				{
					"Type": "NodeText",
					"Data": "。"
				}
			]
		},
		{
			"ID": "20211226123145-ucilhpd",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20211226123145-ucilhpd",
				"updated": "20260810212846"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "所有打過標簽的內容區塊會在標簽分頁（"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Alt"
				},
				{
					"Type": "NodeText",
					"Data": "​+"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "4"
				},
				{
					"Type": "NodeText",
					"Data": " / "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "⌃"
				},
				{
					"Type": "NodeText",
					"Data": "+"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "4"
				},
				{
					"Type": "NodeText",
					"Data": "​）中列出。如果需要取消標簽，在內容區塊中刪掉該標簽即可。"
				}
			]
		},
		{
			"ID": "20261117103000-memo0tw1",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261117103000-memo0tw1",
				"updated": "20261117103000"
			},
			"Children": [
				{
					"Type": "NodeHeadingC8hMarker",
					"Data": "## "
				},
				{
					"Type": "NodeText",
					"Data": "備註"
				}
			]
		},
		{
			"ID": "20261117103000-memo0tw2",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261117103000-memo0tw2",
				"updated": "20261117103000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "選取文字，透過工具列或 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "/"
				},
				{
					"Type": "NodeText",
					"Data": " 選單新增行級備註。"
				}
			]
		},
		{
			"ID": "20261117103000-memo0tw3",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261117103000-memo0tw3",
				"updated": "20261117103000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "目前文件的行級備註集中列在備註面板中，桌面端預設在左側欄書籤旁（圖示為 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "ℹ"
				},
				{
					"Type": "NodeText",
					"Data": "），行動端在側欄選單中。按鈕預設顯示，可見性和位置可在 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "外觀"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "介面"
				},
				{
					"Type": "NodeText",
					"Data": " 的停靠欄中調整。每張卡片上方是被畫線的文字，下方是備註內容。點擊卡片跳到對應內容區塊；點擊備註內容或 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "✎"
				},
				{
					"Type": "NodeText",
					"Data": " 圖示就地編輯，"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Enter"
				},
				{
					"Type": "NodeText",
					"Data": " 儲存，"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Shift"
				},
				{
					"Type": "NodeText",
					"Data": " + "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Enter"
				},
				{
					"Type": "NodeText",
					"Data": " 換行，"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Esc"
				},
				{
					"Type": "NodeText",
					"Data": " 取消。清空內容會移除行級備註，但保留畫線文字。切換文件後面板自動跟隨，正文中修改備註後面板自動重新整理，面板內可以搜尋過濾。"
				}
			]
		},
		{
			"ID": "20230928114735-uks4kf5",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20230928114735-uks4kf5",
				"updated": "20230928114758"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "​"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "tag",
					"TextMarkTextContent": "注意"
				},
				{
					"Type": "NodeText",
					"Data": "​"
				}
			]
		},
		{
			"ID": "20230928114731-0nurd8j",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20230928114731-0nurd8j",
				"updated": "20231205225753"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "請勿在書籤或標籤中使用特殊符號，否則會導致無法全域搜索，也無法在書籤/標籤面板中重新命名和刪除。 這裡的「特殊符號」包括："
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "*"
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "_"
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "["
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "]"
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "!"
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "\\"
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "`"
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "&lt;"
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "&gt;"
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "&amp;"
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "~ "
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "$"
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "("
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": ")"
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "{"
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "}"
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "="
				},
				{
					"Type": "NodeText",
					"Data": "​ 和"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "#"
				},
				{
					"Type": "NodeText",
					"Data": "​。"
				}
			]
		}
	]
}
