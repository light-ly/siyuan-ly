	},
	"Children": [
		{
			"ID": "20210104091414-c8862yg",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20210104091414-c8862yg",
				"updated": "20261024161440"
			},
			"Children": [
				{
					"Type": "NodeHeadingC8hMarker",
					"Data": "## "
				},
				{
					"Type": "NodeText",
					"Data": "Bookmark"
				}
			]
		},
		{
			"ID": "20210104091414-5n6da7j",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20210104091414-5n6da7j",
				"updated": "20210702231509"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "If you need to \"favorite\" content blocks, please open the attribute panel through the block icon menu, and then you can set bookmarks in the attribute panel."
				}
			]
		},
		{
			"ID": "20210104091414-b6lifws",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20210104091414-b6lifws",
				"updated": "20261024161440"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Bookmarked blocks appear in the bookmark panel ("
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "Alt"
				},
				{
					"Type": "NodeText",
					"Data": "+"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "3"
				},
				{
					"Type": "NodeText",
					"Data": ", or "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "Control"
				},
				{
					"Type": "NodeText",
					"Data": "+"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "3"
				},
				{
					"Type": "NodeText",
					"Data": " on macOS). To remove a bookmark, clear the block’s bookmark attribute or use the delete action in the bookmark panel. This removes the bookmark and leaves the block intact."
				}
			]
		},
		{
			"ID": "20210104091414-qp10fn0",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20210104091414-qp10fn0",
				"updated": "20260810212846"
			},
			"Children": [
				{
					"Type": "NodeHeadingC8hMarker",
					"Data": "## "
				},
				{
					"Type": "NodeText",
					"Data": "Tag"
				}
			]
		},
		{
			"ID": "20210104091414-x7yerg6",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20210104091414-x7yerg6"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "The tag is used to mark the block in the content block. The syntax is to wrap the tag identifier with two "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "#"
				},
				{
					"Type": "NodeText",
					"Data": " in the first and one after the other, like this "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "#Tag#"
				},
				{
					"Type": "NodeText",
					"Data": "."
				}
			]
		},
		{
			"ID": "20210104091414-4cl5j5v",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20210104091414-4cl5j5v"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Tag support hierarchical levels, so that content blocks can be sorted more easily. Use "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "/"
				},
				{
					"Type": "NodeText",
					"Data": " to separate different levels, like this "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "#A/B/C#"
				},
				{
					"Type": "NodeText",
					"Data": "."
				}
			]
		},
		{
			"ID": "20210104091414-s3vdbdu",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20210104091414-s3vdbdu",
				"updated": "20260810212846"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "All tagged content blocks will be listed in the tag tab ("
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Alt"
				},
				{
					"Type": "NodeText",
					"Data": "​+"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "4"
				},
				{
					"Type": "NodeText",
					"Data": " / "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "⌃"
				},
				{
					"Type": "NodeText",
					"Data": "+"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "4"
				},
				{
					"Type": "NodeText",
					"Data": "​). If you need to cancel the tag, just delete the tag in the content block."
				}
			]
		},
		{
			"ID": "20261117103000-memo0en1",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261117103000-memo0en1",
				"updated": "20261117103000"
			},
			"Children": [
				{
					"Type": "NodeHeadingC8hMarker",
					"Data": "## "
				},
				{
					"Type": "NodeText",
					"Data": "Memo"
				}
			]
		},
		{
			"ID": "20261117103000-memo0en2",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261117103000-memo0en2",
				"updated": "20261117103000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Select text and add an inline memo from the toolbar or the "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "/"
				},
				{
					"Type": "NodeText",
					"Data": " menu."
				}
			]
		},
		{
			"ID": "20261117103000-memo0en3",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261117103000-memo0en3",
				"updated": "20261117103000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Inline memos in the current document are listed as cards in the memo panel. On desktop it sits in the left sidebar next to bookmarks by default (icon "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "ℹ"
				},
				{
					"Type": "NodeText",
					"Data": "); on mobile it is in the sidebar menu. The button is shown by default, and its visibility and position can be changed under "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Settings"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Appearance"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Interface"
				},
				{
					"Type": "NodeText",
					"Data": ", in the dock bar. Each card shows the underlined text above and the memo below. Click a card to jump to its block; click the memo text or the "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "✎"
				},
				{
					"Type": "NodeText",
					"Data": " icon to edit it in place, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Enter"
				},
				{
					"Type": "NodeText",
					"Data": " to save, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Shift"
				},
				{
					"Type": "NodeText",
					"Data": " + "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Enter"
				},
				{
					"Type": "NodeText",
					"Data": " for a new line, and "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Esc"
				},
				{
					"Type": "NodeText",
					"Data": " to cancel. Clearing the text removes the inline memo but keeps the underline. The panel follows the open document, refreshes when a memo changes in the editor, and can be filtered by search."
				}
			]
		},
		{
			"ID": "20230928113947-gnlob5l",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20230928113947-gnlob5l",
				"updated": "20230928113958"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "tag",
					"TextMarkTextContent": "Note"
				},
				{
					"Type": "NodeText",
					"Data": "​"
				}
			]
		},
		{
			"ID": "20230928113959-ebzf9zy",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20230928113959-ebzf9zy",
				"updated": "20231205225745"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Please do not use special symbols in bookmarks or tags, otherwise you will not be able to search globally, and you will not be able to rename and delete them in the bookmarks/tags panel. The \"special symbols\" here include: "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "*"
				},
				{
					"Type": "NodeText",
					"Data": "​, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "_"
				},
				{
					"Type": "NodeText",
					"Data": "​, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "["
				},
				{
					"Type": "NodeText",
					"Data": "​, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "]"
				},
				{
					"Type": "NodeText",
					"Data": "​, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "!"
				},
				{
					"Type": "NodeText",
					"Data": "​, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "\\"
				},
				{
					"Type": "NodeText",
					"Data": "​, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "`"
				},
				{
					"Type": "NodeText",
					"Data": "​ , "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "&lt;"
				},
				{
					"Type": "NodeText",
					"Data": "​, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "&gt;"
				},
				{
					"Type": "NodeText",
					"Data": "​, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "&amp;"
				},
				{
					"Type": "NodeText",
					"Data": "​, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "~ "
				},
				{
					"Type": "NodeText",
					"Data": "​, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "$"
				},
				{
					"Type": "NodeText",
					"Data": "​, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "("
				},
				{
					"Type": "NodeText",
					"Data": "​, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": ")"
				},
				{
					"Type": "NodeText",
					"Data": "​, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "{"
				},
				{
					"Type": "NodeText",
					"Data": "​, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "}"
				},
				{
					"Type": "NodeText",
					"Data": "​, "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "="
				},
				{
					"Type": "NodeText",
					"Data": "​ and "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "#"
				},
				{
					"Type": "NodeText",
					"Data": "​."
				}
			]
		}
	]
}
