{
	"ID": "20240530101000-xc13cm6",
	"Spec": "2",
	"Type": "NodeDocument",
	"Properties": {
		"ID": "20240530101000-fswowem",
		"id": "20240530101000-xc13cm6",
		"title": "ブックマーク、タグ、メモ",
		"type": "doc",
		"updated": "20261117103000"
	},
	"Children": [
		{
			"ID": "20240530101000-hprjkt6",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"ID": "20240530101000-pvnwpym",
				"id": "20240530101000-hprjkt6",
				"updated": "20261024161440"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "ブックマーク"
				}
			]
		},
		{
			"ID": "20240530101000-lzmfgny",
			"Type": "NodeParagraph",
			"Properties": {
				"ID": "20240530101000-pqnex1k",
				"id": "20240530101000-lzmfgny",
				"updated": "20240530101000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "コンテンツブロックをブックマークに追加するには、ブロックメニューから属性を開いてブックマークの名前を設定します。"
				}
			]
		},
		{
			"ID": "20240530101000-knmtutw",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20240530101000-knmtutw",
				"updated": "20261024161440"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "ブックマークしたブロックはブックマークパネルに表示されます（"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "Alt"
				},
				{
					"Type": "NodeText",
					"Data": "+"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "3"
				},
				{
					"Type": "NodeText",
					"Data": "、macOS では "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "Control"
				},
				{
					"Type": "NodeText",
					"Data": "+"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "3"
				},
				{
					"Type": "NodeText",
					"Data": "）。解除するには、ブロックのブックマーク属性を空にするか、パネルの削除操作を使います。ブックマークだけが解除され、ブロックは削除されません。"
				}
			]
		},
		{
			"ID": "20240530101000-hm4v83l",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"ID": "20240530101000-jxde0hd",
				"id": "20240530101000-hm4v83l",
				"updated": "20261024163013"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "タグ"
				}
			]
		},
		{
			"ID": "20240530101000-3km22xj",
			"Type": "NodeParagraph",
			"Properties": {
				"ID": "20240530101000-qec15ab",
				"id": "20240530101000-3km22xj",
				"updated": "20261024163013"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "タグはコンテンツブロックにマークを付けるためのもので、タグとなる文字列を選択してフローティングツールバーからタグ付けするか、文字列の前後を "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "#タグ名#"
				},
				{
					"Type": "NodeText",
					"Data": "​ のように囲みます (これは、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "エディタ"
				},
				{
					"Type": "NodeText",
					"Data": " の Markdown インラインタグ構文が有効である有効である必要があります)。"
				}
			]
		},
		{
			"ID": "20240530101000-1llvzhg",
			"Type": "NodeParagraph",
			"Properties": {
				"ID": "20240530101000-r7crqu2",
				"id": "20240530101000-1llvzhg",
				"updated": "20240530101000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "タグは階層構造をサポートしているため、コンテンツブロックを簡単に分類・整理できます。異なる階層を区切るには "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "/"
				},
				{
					"Type": "NodeText",
					"Data": "​ を使用します (例: "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "#A/B/C#"
				},
				{
					"Type": "NodeText",
					"Data": "​)。"
				}
			]
		},
		{
			"ID": "20240530101000-hyy7lip",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20240530101000-hyy7lip",
				"updated": "20260810212846"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "タグ付けされたコンテンツブロックはタグタブ ("
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Alt"
				},
				{
					"Type": "NodeText",
					"Data": "​+"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "4"
				},
				{
					"Type": "NodeText",
					"Data": " / "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "⌃"
				},
				{
					"Type": "NodeText",
					"Data": "+"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "4"
				},
				{
					"Type": "NodeText",
					"Data": "​) に一覧表示されます。タグを解除するには、対象のブックマークを右クリックするかドロップダウンメニューから削除を選ぶか、コンテンツブロック内のタグを削除します。"
				}
			]
		},
		{
			"ID": "20261117103000-memo0ja1",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20261117103000-memo0ja1",
				"updated": "20261117103000"
			},
			"Children": [
				{
					"Type": "NodeHeadingC8hMarker",
					"Data": "## "
				},
				{
					"Type": "NodeText",
					"Data": "メモ"
				}
			]
		},
		{
			"ID": "20261117103000-memo0ja2",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261117103000-memo0ja2",
				"updated": "20261117103000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "文字列を選択し、ツールバーまたは "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "/"
				},
				{
					"Type": "NodeText",
					"Data": " メニューからインラインメモを追加します。"
				}
			]
		},
		{
			"ID": "20261117103000-memo0ja3",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20261117103000-memo0ja3",
				"updated": "20261117103000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "現在のドキュメントのインラインメモは、メモパネルにカードとして一覧表示されます。デスクトップでは左サイドバーのブックマークの隣に既定で表示され（アイコンは "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "ℹ"
				},
				{
					"Type": "NodeText",
					"Data": "）、モバイルではサイドバーメニューにあります。ボタンは既定で表示され、表示と位置は "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "設定"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "スタイル"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "インターフェース"
				},
				{
					"Type": "NodeText",
					"Data": " のドックバーで変更できます。各カードは、上が下線付きのテキスト、下がメモの内容です。カードをクリックすると対応するブロックへ移動し、メモの内容または "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "✎"
				},
				{
					"Type": "NodeText",
					"Data": " アイコンをクリックするとその場で編集できます。"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Enter"
				},
				{
					"Type": "NodeText",
					"Data": " で保存、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Shift"
				},
				{
					"Type": "NodeText",
					"Data": " + "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Enter"
				},
				{
					"Type": "NodeText",
					"Data": " で改行、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Esc"
				},
				{
					"Type": "NodeText",
					"Data": " でキャンセルします。内容を空にするとインラインメモは削除されますが、下線のテキストは残ります。ドキュメントを切り替えるとパネルは自動的に追従し、本文でメモを変更すると自動的に更新され、パネル内で検索して絞り込めます。"
				}
			]
		},
		{
			"ID": "20240530101000-stn83j3",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"ID": "20240530101000-0ao0iv9",
				"id": "20240530101000-stn83j3",
				"updated": "20261016202856"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "​"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "tag",
					"TextMarkTextContent": "注意事項"
				},
				{
					"Type": "NodeText",
					"Data": "​"
				}
			]
		},
		{
			"ID": "20240530101000-2rbdegz",
			"Type": "NodeParagraph",
			"Properties": {
				"ID": "20240530101000-fvylnn8",
				"id": "20240530101000-2rbdegz",
				"updated": "20261016202856"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "ブックマークやタグには次の特殊記号を使用しないでください。これらの特殊記号を使用するとグローバル検索の対象外となり、ブックマーク/タグパネルから名前の変更や削除ができなくなります: "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "*"
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "_"
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "["
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "]"
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "!"
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "\\"
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "`"
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "&lt;"
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "&gt;"
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "&amp;"
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "~"
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "$"
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "("
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": ")"
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "{"
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "}"
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "="
				},
				{
					"Type": "NodeText",
					"Data": "​、"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "#"
				},
				{
					"Type": "NodeText",
					"Data": "​。"
				}
			]
		},
		{
			"ID": "20240530101000-mncd4tp",
